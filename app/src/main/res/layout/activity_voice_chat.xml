<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rl_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <!-- android:background="@drawable/bg_chat_gradient"> -->

    <!-- 主要内容区域 -->
    <RelativeLayout
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >

        <!-- Live2D 角色显示区域（作为背景，铺满屏幕） -->
        <FrameLayout
            android:id="@+id/live2d_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:clipChildren="true"
            android:clipToPadding="true"
            android:visibility="visible">

            <WebView
                android:id="@+id/live2d_webview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

        </FrameLayout>

        <!-- 对话日志区域（悬浮居中） -->
        <LinearLayout
            android:id="@+id/dialog_container"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            android:layout_marginTop="-32dp"
            android:background="@android:color/transparent"
            android:orientation="vertical">


            <!-- 对话内容滚动区域 -->
            <ScrollView
                android:id="@+id/scroll_logs"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:background="@drawable/bg_dialog_overlay"
                android:padding="16dp"
                android:scrollbars="vertical"
                android:fadeScrollbars="false">

                <TextView
                    android:id="@+id/tv_logs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="8dp"
                    android:text="等待对话开始..."
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:textIsSelectable="true"
                    android:gravity="center" />

            </ScrollView>

            <!-- 音乐播放显示区域 -->
            <LinearLayout
                android:id="@+id/music_player_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/rounded_edittext"
                android:elevation="4dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <!-- 音乐播放标题栏 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🎵 音乐播放"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- 停止播放按钮 -->
                    <LinearLayout
                        android:id="@+id/btn_stop_music"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/rounded_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:padding="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⏹️"
                            android:textSize="12sp"
                            android:layout_marginEnd="4dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="停止"
                            android:textColor="@color/background_light"
                            android:textSize="12sp" />

                    </LinearLayout>

                </LinearLayout>

                <!-- 音乐信息显示 -->
                <TextView
                    android:id="@+id/tv_music_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="暂无音乐播放"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <!-- 播放进度条 -->
                <ProgressBar
                    android:id="@+id/progress_music"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginBottom="8dp"
                    android:indeterminate="false"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

        <!-- 底部控制区域（合并到背景区域，透明） -->
        <LinearLayout
            android:id="@+id/bottom_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_margin="16dp"
            android:background="@android:color/transparent"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 状态显示 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@android:color/transparent"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:id="@+id/tv_state_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="●"
                    android:textSize="10sp"
                    android:textColor="@color/text_secondary"
                    android:alpha="0.6" />

                <TextView
                    android:id="@+id/tv_state"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="准备中..."
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:alpha="0.9"
                    android:gravity="center" />

            </LinearLayout>

            <!-- 控制按钮区域 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- 打断/说话按钮 -->
                <LinearLayout
                    android:id="@+id/btn_interrupt"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/rounded_button_red"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="invisible">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎤"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/tv_interrupt_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="打断"
                        android:textColor="@color/black"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- 退出按钮 -->
                <LinearLayout
                    android:id="@+id/btn_exit"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginStart="16dp"
                    android:background="@drawable/rounded_circle_soft"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="❌"
                        android:textSize="18sp"
                        android:alpha="0.8" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="退出"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:alpha="0.85" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </RelativeLayout>

    <!-- 悬浮视频窗口（视频模式显示，不遮挡字幕/日志） -->
    <FrameLayout
        android:id="@+id/video_container"
        android:layout_width="160dp"
        android:layout_height="120dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="16dp"
        
        android:background="@drawable/bg_pip_window"
        android:outlineProvider="background"
        android:clipToOutline="true"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:padding="2dp"
        android:elevation="20dp"
        android:visibility="gone" />

</RelativeLayout>